# Response headers. Cloudflare Pages (and Netlify) read this file from the published folder.

# Security headers for every page.
/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=()

# Script and style files have a hash in their name, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Small photo copies: the file name changes whenever the photo or its settings change.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the Cloudflare preview addresses out of Google: only www.tablelk.com should be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
